# ==========================================
# CẤU HÌNH HỆ THỐNG FKM SOFTWARE FACTORY
# ==========================================

# Cổng và Địa chỉ Factory Web Server (Giao diện chính)
FACTORY_HOST=0.0.0.0
FACTORY_PORT=8090

# Cổng và Địa chỉ Multi-Provider Web Bridge (Kết nối ChatGPT / DeepSeek Web)
FACTORY_BRIDGE_HOST=127.0.0.1
FACTORY_BRIDGE_PORT=8001
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8001

# Thư mục lưu hồ sơ trình duyệt Playwright (Giữ trạng thái đăng nhập)
BRIDGE_PROFILES_DIR=./bridge/profiles

# Thời gian chờ tối đa cho một lượt suy luận của AI (giây) - Mặc định 7200s (2 tiếng)
BRIDGE_MAX_TIMEOUT_SEC=7200

# Khóa API DeepSeek chính thức (Tùy chọn, để trống nếu dùng ChatGPT Web Bridge miễn phí)
DEEPSEEK_API_KEY=
